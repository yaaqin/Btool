# Copy to .env and adjust — .env is auto-loaded on startup (godotenv),
# and gitignored so your local overrides never get committed.

# Port the API listens on.
PORT=9721

# Per-IP audit quota. Raise/lower without touching code or rebuilding.
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=4h

# Origin allowed to call this API from the browser (the Next.js app).
CORS_ORIGIN=http://localhost:9722
