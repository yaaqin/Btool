# Copy to .env and adjust — .env is auto-loaded on startup (godotenv),
# and gitignored so your local overrides never get committed.

# Port the API listens on.
PORT=9721

# Per-IP audit quota. Raise/lower without touching code or rebuilding.
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=4h

# Origin allowed to call this API from the browser (the Next.js app).
CORS_ORIGIN=http://localhost:9722

# Postgres connection (not read by any code yet — see the note in the
# handover about that). Placeholder below, never commit a real password.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=disable

# Render service (render-service/, headless Chromium) for the "rendered"
# column of the metadata report. Leave unset to skip rendering — the raw
# column still works. docker-compose.yml sets this for you.
RENDER_SERVICE_URL=http://localhost:9723

# Password for the metadata page (it drives a headless browser, so it isn't
# public). A correct password unlocks it for 1 hour. Leave unset and the
# metadata endpoint stays locked for everyone. Never commit the real one.
METADATA_PASSWORD=change-me
