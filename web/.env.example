# Base URL of the Go API. Must be prefixed NEXT_PUBLIC_ since it's read
# from the browser. Defaults to http://localhost:9721 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9721

# /seo-development rules. Server-only, read per request (restart, no rebuild).
# Longest meta title before "Berkualitas"/"Jual" are dropped (search exempt).
SEO_DEV_TITLE_MAX_LENGTH=60
# A /products page is indexable only with at least this many products...
SEO_DEV_MIN_PRODUCTS=3
# ...and at least this percentage of them in stock.
SEO_DEV_MIN_IN_STOCK_PERCENT=50
