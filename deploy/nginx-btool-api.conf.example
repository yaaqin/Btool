# Reverse proxy for btool-api.yaaqin.xyz -> the btool-api container
# (published on 127.0.0.1:9721 only — see docker-compose.yml).
#
# Copy to /etc/nginx/sites-available/btool-api.conf, symlink into
# sites-enabled, then run certbot as shown below.

server {
    listen 80;
    server_name btool-api.yaaqin.xyz;

    location / {
        proxy_pass http://127.0.0.1:9721;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# After certbot runs (see DEPLOY.md), it adds its own server block here
# for port 443 with the obtained certificate — no manual edit needed.
